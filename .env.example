# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nexus_auth

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TOKEN_EXPIRE_HOURS=24

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# API
API_SECRET_HEADER=X-Nexus-Secret
API_SECRET_VALUE=CHANGE_THIS_SECRET_HEADER_VALUE

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_HEARTBEAT=30/minute

# Security
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,https://auth-71s4.onrender.com

# App
DEBUG=false
APP_VERSION=1
